# =================================
# MMSS Job Board Environment Variables
# =================================
# Copy this file to .env.local and fill in your values

# ---------------------------------
# Supabase Configuration (Required)
# ---------------------------------
# Get these from your Supabase project settings > API

# Public URL - safe to expose to browser
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Anon Key - public key for client-side operations (RLS enforced)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service Role Key - NEVER expose to browser (bypasses RLS)
# Used for server-side operations that need to bypass row-level security
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------
# Application Configuration
# ---------------------------------
# Your deployed app URL (used for redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------
# Google sign-in (local Supabase only)
# ---------------------------------
# Only needed to run Google sign-in against a LOCAL Supabase stack — the
# hosted project takes these in its dashboard instead (Authentication >
# Providers > Google), not from this file.
# Export both in the shell that runs `supabase start`, then set
# enabled = true under [auth.external.google] in supabase/config.toml.
SUPABASE_AUTH_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_GOOGLE_SECRET=

# ---------------------------------
# Admin access
# ---------------------------------
# Comma-separated email domains whose members are granted admin access
# automatically on their first Google sign-in, without an invitation.
# Leave unset or empty for invite-only, which is the safe default.
#
# Every address on a listed domain becomes an admin, so list only domains the
# committee controls end to end. monashclubs.org is shared Monash Clubs /
# MSA infrastructure -- listing it would hand the dashboard to any club
# officer with an address on it. mmss@monashclubs.org keeps its access as the
# recovery admin, which is checked before this list and needs no entry here.
# Example: monashmss.com
ADMIN_AUTO_APPROVE_DOMAINS=

# ---------------------------------
# Email (Resend) — for job submission notifications
# ---------------------------------
# Get your API key from https://resend.com
# Requires a verified sender domain (monashmss.com)
RESEND_API_KEY=re_your_api_key_here

# ---------------------------------
# AI Job Prefill (Google Gemini) — optional
# ---------------------------------
# Used by /api/prefill-job as a fallback extraction tier when a job posting
# page has no structured JobPosting JSON-LD or embedded ATS data. Prefill
# still works without this key via the JSON-LD/embedded-state/heuristic tiers.
# Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ---------------------------------
# Rate limiting (submit-job) — optional but recommended
# ---------------------------------
# Secret used to HMAC-hash the submitter's IP before storing it in
# submission_rate_limits (see lib/rate-limit.ts). Without this, IP hashes
# fall back to plain unsalted SHA-256, which is reversible across the whole
# IPv4 address space in well under an hour on one CPU core. Any long random
# string works, e.g. `openssl rand -hex 32`.
RATE_LIMIT_HASH_PEPPER=

# ---------------------------------
# Development Configuration
# ---------------------------------
# For local Supabase development (supabase start)
# Uncomment these when using Supabase local:
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<local-anon-key>
# SUPABASE_SERVICE_ROLE_KEY=<local-service-role-key>
